{
  "name": "yoin-monorepo",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "cd packages/core && wasm-pack build --target web --out-dir pkg-web --out-name core",
    "build:client": "pnpm --filter @yoin/client build",
    "build": "pnpm build:wasm && pnpm build:client",
    "test": "pnpm --filter @yoin/client test && node tests/monorepo-integrity.test.mjs",
    "test:unit": "pnpm --filter @yoin/client test",
    "test:integration": "node tests/monorepo-integrity.test.mjs",
    "test:coverage": "pnpm --filter @yoin/client test:coverage",
    "server:dev": "cargo run --package yoin-sync-server",
    "server:test": "cargo test --package yoin-sync-server",
    "cargo:test": "cargo test",
    "typecheck": "pnpm --filter @yoin/client typecheck",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  }
}
