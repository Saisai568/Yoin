{
  "name": "@yoin/client",
  "version": "0.1.0",
  "type": "module",
  "description": "Yoin Framework - Real-time collaborative TypeScript SDK powered by CRDT and WASM",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@yoin/core": "workspace:*",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.0.18",
    "happy-dom": "^20.6.1",
    "react": "^19.2.4",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  },
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "crdt",
    "collaboration",
    "real-time",
    "wasm",
    "yjs"
  ]
}
